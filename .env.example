# === LuxuryB2B — variables d'environnement ===
# Copie ce fichier en .env.local (dev) et renseigne les mêmes valeurs sur Vercel.

# URL publique du site (sans slash final) — sert aux métadonnées / OG
NEXT_PUBLIC_SITE_URL=https://ton-domaine.vercel.app

# --- Admin (/admin) ---
# Mot de passe du back-office (choisis une valeur forte)
ADMIN_DASHBOARD_TOKEN=change-moi

# --- Airtable (contenu éditable + leads) ---
# Personal Access Token Airtable (https://airtable.com/create/tokens)
AIRTABLE_API_KEY=pat_xxx
# ID de la base (commence par app...)
AIRTABLE_BASE_ID=appXXXXXXXX
# Noms des tables (défauts : "Paramètres" et "Webhooks")
AIRTABLE_SETTINGS_TABLE=Paramètres
AIRTABLE_WEBHOOKS_TABLE=Webhooks

# --- Webhook des leads « Ça m'intéresse » (optionnel) ---
# Peut aussi se régler dans /admin (onglet Contenu). Priorité au réglage admin.
INTEREST_WEBHOOK_URL=

# --- E-mails automatiques via Resend ---
# À chaque demande : 1 mail interne (à INTEREST_TO_EMAIL) + 1 confirmation au demandeur.
# 1) Crée un compte sur https://resend.com  2) Vérifie le domaine luxuryevent.be
#    (ajoute les enregistrements DNS SPF/DKIM fournis)  3) Crée une clé API.
# Sans RESEND_API_KEY : aucun mail n'est envoyé (le lead + le webhook fonctionnent quand même).
RESEND_API_KEY=re_xxx
# Expéditeur : DOIT être sur le domaine vérifié dans Resend.
INTEREST_FROM_EMAIL=LuxuryEvent <contact@luxuryevent.be>
# Destinataire des notifications internes (par défaut contact@luxuryevent.be).
INTEREST_TO_EMAIL=contact@luxuryevent.be
